{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RequirementExtractionV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["requirements"],
  "properties": {
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "title",
          "condition",
          "expected_behavior",
          "lifecycle_status",
          "evidence_message_ids",
          "confidence",
          "missing_information"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "pattern": "^R-[0-9]{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "condition": {
            "type": ["string", "null"]
          },
          "expected_behavior": {
            "type": "string",
            "minLength": 1
          },
          "lifecycle_status": {
            "enum": [
              "proposed",
              "active",
              "rejected",
              "superseded",
              "cancelled",
              "unknown"
            ]
          },
          "evidence_message_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "confidence": {
            "enum": ["high", "medium", "low"]
          },
          "missing_information": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
