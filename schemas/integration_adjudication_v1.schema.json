{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IntegrationAdjudicationV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["cluster_id", "judgments", "unclassified_decision_keys"],
  "properties": {
    "cluster_id": {
      "type": "string",
      "pattern": "^CLUSTER-[0-9a-f]{12}$"
    },
    "judgments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "judgment_id",
          "relation",
          "member_decision_keys",
          "direction",
          "rationale",
          "evidence_refs",
          "confidence",
          "missing_information"
        ],
        "properties": {
          "judgment_id": {
            "type": "string",
            "pattern": "^J-[0-9]{3}$"
          },
          "relation": {
            "enum": [
              "same_decision",
              "lifecycle_relation",
              "parent_child",
              "distinct",
              "not_decision",
              "uncertain"
            ]
          },
          "member_decision_keys": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^SEC-[0-9]{3}:D-[0-9]{3}$"
            }
          },
          "direction": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["from_decision_key", "relation", "to_decision_key"],
                "properties": {
                  "from_decision_key": {
                    "type": "string",
                    "pattern": "^SEC-[0-9]{3}:D-[0-9]{3}$"
                  },
                  "relation": {
                    "enum": [
                      "accepts",
                      "changes",
                      "supersedes",
                      "rejects",
                      "cancels",
                      "reverts",
                      "parent_of"
                    ]
                  },
                  "to_decision_key": {
                    "type": "string",
                    "pattern": "^SEC-[0-9]{3}:D-[0-9]{3}$"
                  }
                }
              }
            ]
          },
          "rationale": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["evidence_type", "evidence_id"],
              "properties": {
                "evidence_type": {"enum": ["message", "attachment"]},
                "evidence_id": {"type": "string", "minLength": 1}
              }
            }
          },
          "confidence": {"enum": ["high", "medium", "low"]},
          "missing_information": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "unclassified_decision_keys": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SEC-[0-9]{3}:D-[0-9]{3}$"
      }
    }
  }
}
