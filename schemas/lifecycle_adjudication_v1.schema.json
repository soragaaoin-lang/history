{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LifecycleAdjudicationV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["group_id", "results"],
  "properties": {
    "group_id": {"type": "string", "pattern": "^LIFECYCLE-SEC-[0-9]{3}$"},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_id", "final_status", "rationale", "evidence_refs", "confidence", "missing_information"],
        "properties": {
          "decision_id": {"type": "string", "pattern": "^ID-[0-9]{3}$"},
          "final_status": {"enum": ["proposed", "accepted", "rejected", "superseded", "cancelled", "reverted"]},
          "rationale": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["evidence_type", "evidence_id"],
              "properties": {
                "evidence_type": {"enum": ["message", "attachment"]},
                "evidence_id": {"type": "string", "minLength": 1}
              }
            }
          },
          "confidence": {"enum": ["high", "medium", "low"]},
          "missing_information": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
