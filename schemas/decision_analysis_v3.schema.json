{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DecisionAnalysisV3",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisions"],
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_id", "title", "decision", "context", "alternatives", "rationale", "rejected_alternatives", "risks", "revisit_conditions", "evidence_refs", "confidence", "missing_information", "status"],
        "properties": {
          "decision_id": {"type": "string", "pattern": "^D-[0-9]{3}$"},
          "title": {"type": "string", "minLength": 1},
          "decision": {"type": "string", "minLength": 1},
          "context": {"type": ["string", "null"]},
          "alternatives": {"type": "array", "items": {"type": "string"}},
          "rationale": {"type": "array", "items": {"type": "string"}},
          "rejected_alternatives": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["alternative", "reason"],
              "properties": {
                "alternative": {"type": "string"},
                "reason": {"type": "string"}
              }
            }
          },
          "risks": {"type": "array", "items": {"type": "string"}},
          "revisit_conditions": {"type": "array", "items": {"type": "string"}},
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["evidence_type", "evidence_id"],
              "properties": {
                "evidence_type": {"enum": ["message", "attachment"]},
                "evidence_id": {"type": "string", "minLength": 1}
              }
            }
          },
          "confidence": {"enum": ["high", "medium", "low"]},
          "missing_information": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["proposed", "accepted", "rejected", "superseded", "reverted", "cancelled", "unknown"]}
        }
      }
    }
  }
}
